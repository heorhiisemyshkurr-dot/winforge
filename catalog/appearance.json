[
  {
    "id": "dark_mode",
    "category": "appearance",
    "title": "Тёмная тема",
    "detail": "Тёмное оформление и для системы, и для приложений. Два значения пишутся вместе: поставь только одно — и получишь тёмное меню «Пуск» при светлых окнах.",
    "effect": "immediate",
    "risk": "safe",
    "needs_admin": false,
    "exclusive": "theme",
    "action": {
      "type": "RegGroup",
      "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "values": [
        { "name": "AppsUseLightTheme", "kind": "REG_DWORD", "data": "0" },
        { "name": "SystemUsesLightTheme", "kind": "REG_DWORD", "data": "0" }
      ]
    }
  },
